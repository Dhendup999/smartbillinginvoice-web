# Paddle (live). Copy to .env for local `netlify dev`, or set in Netlify > Project configuration > Environment variables.
# Never commit real values.

# Client-side token from Paddle > Developer tools > Authentication > Client-side tokens. Must start with live_
PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side API key from Paddle > Developer tools > Authentication > API keys. Must start with pdl_live_apikey_
# (Use the secret key itself, not the key's apikey_... ID.)
PADDLE_API_KEY=pdl_live_apikey_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret (endpoint_secret_key) of the live notification destination. Must start with pdl_ntfset_
# (Use the secret key itself, not the destination's ntfset_... ID.)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Leave unset for live. Set to "sandbox" only for local testing against sandbox.
PADDLE_ENV=

# Optional overrides for the live price IDs (defaults are in netlify/lib/paddle.js).
PADDLE_MONTHLY_PRICE_ID=
PADDLE_YEARLY_PRICE_ID=

# License email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_ALERT_EMAIL=

# License key generation (keep secret)
SB_SEAL_DOMAIN_SALT=
SB_MASTER_PEPPER=
